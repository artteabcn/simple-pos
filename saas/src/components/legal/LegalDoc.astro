---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { legalDoc, type LegalKind } from "../../content/legal";
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
  locale: Locale;
  kind: LegalKind;
}
const { locale, kind } = Astro.props;
const t = useTranslations(locale);
const { doc, translated } = legalDoc(kind, locale);
const others = (["terms", "privacy", "refunds"] as const).filter((k) => k !== kind);
---

<BaseLayout locale={locale} title={`${doc.title} | ${t.app.name}`}>
  <div class="min-h-screen bg-stone-50 text-stone-900">
    <header class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-4">
      <a href={`/${locale}/`} class="text-xl font-extrabold whitespace-nowrap text-brand">Simple POS</a>
      <a href={`/${locale}/`} class="flex min-h-11 items-center text-base font-semibold text-stone-700 hover:text-brand">{t.legal.back}</a>
    </header>
    <main class="mx-auto max-w-3xl px-4 pt-4 pb-16">
      <h1 class="text-3xl leading-tight font-extrabold tracking-tight sm:text-4xl">{doc.title}</h1>
      {!translated && <p class="mt-4 rounded-xl bg-amber-50 p-4 text-base text-amber-900" role="note">{t.legal.notice}</p>}
      <article
        class="mt-6 text-base leading-relaxed text-stone-700 [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-stone-900 [&_li]:mt-1.5 [&_p]:mt-3 [&_strong]:text-stone-900 [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:pl-6"
        set:html={doc.html}
      />
    </main>
    <footer class="border-t border-stone-200 bg-white">
      <nav class="mx-auto flex max-w-3xl flex-wrap gap-x-6 gap-y-2 px-4 py-6 text-base" aria-label="Legal">
        {others.map((k) => <a href={`/${locale}/${k}/`} class="font-semibold text-stone-800 hover:text-brand">{t.legal[k]}</a>)}
      </nav>
    </footer>
  </div>
</BaseLayout>
