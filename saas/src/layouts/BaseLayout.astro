---
import "../styles/global.css";
import { INTL_TAG, LOCALES, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
}
const { locale, title, description = "" } = Astro.props;
const path = Astro.url.pathname.replace(/^\/(en|th|fr|de)(?=\/|$)/, "");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(`/${locale}${path}`, Astro.site ?? Astro.url).href} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={INTL_TAG[l]} href={`/${l}${path}`} />)}
  </head>
  <body class="min-h-screen font-sans antialiased">
    <slot />
  </body>
</html>
