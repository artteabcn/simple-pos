{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "scripts", "migrations", ".wrangler"],
  "compilerOptions": {
    "jsx": "react-jsx",
